# Copy to .env and fill in. Every value is checked at startup by src/config.ts.

NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# The frontend's address. Browsers may call the API only from here, and sign-in sends people back here.
# It must be on the same site as API_URL (e.g. app.testick.dev and api.testick.dev) so the session cookie is sent.
FRONTEND_URL=http://localhost:5173
# Where this API is reached from browsers. The GitHub App's callback URL is API_URL + /api/auth/github/callback.
API_URL=http://localhost:4000

# How many proxies (load balancer, CDN) sit in front of the app. 0 when it is reached directly.
# Wrong here means the rate limiter sees the proxy's address instead of the caller's.
TRUST_PROXY=0

# Supabase: Project Settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co
# The secret key (sb_secret_...) or the legacy service_role key. It bypasses row level security:
# never put it in the frontend or commit it.
SUPABASE_SECRET_KEY=

# The GitHub App: GitHub > Settings > Developer settings > GitHub Apps > your app.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The app itself, for reading code during syncs: its App ID, and a private key (Generate a private key, a .pem
# file) base64-encoded on one line:
#   node -e "console.log(require('fs').readFileSync('the-key.pem').toString('base64'))"
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Proves webhooks come from GitHub. Any 32+ random characters; paste the same value into the app's Webhook secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_WEBHOOK_SECRET=

# The AI that finds features and writes scenarios: any OpenAI-compatible chat API. Gemini by default, whose key
# is free at aistudio.google.com/apikey. On the free tier Google may use what is sent (your code) to improve its
# products; a paid key does not. The free tier allows about 20 requests a day per model: a first sync takes about
# 1 + (features / 5). Groq's free tier allows too few tokens a minute for a whole repository.
AI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Several models, comma-separated: when one is busy (free tiers often are), the next is tried at once.
# AI_MODEL=gemini-3.6-flash,gemini-3.8-flash,gemini-3-flash-preview

# Contact-form messages are emailed through Resend: resend.com > API Keys (free: 3,000 a month, 100 a day).
# Until you verify a domain there, Resend sends only from onboarding@resend.dev and only to the address you
# signed up with, so CONTACT_INBOX must be that address. Replying to an email answers the visitor.
RESEND_API_KEY=
CONTACT_INBOX=
# CONTACT_FROM=Testick <onboarding@resend.dev>

# Encrypts the GitHub tokens stored in the database. 32 random bytes in base64, made with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes every stored token unreadable, so everyone has to sign in again.
TOKEN_ENCRYPTION_KEY=
